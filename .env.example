# Hub
HEARTH_PORT=8790
HEARTH_STT_URL=http://127.0.0.1:8080/v1/audio/transcriptions
HEARTH_STT_MODEL=qwen3-asr-0.6b-cpu
# LAN URL the NOTE4 and Hermes MCP bridge can reach. Required for profile installation.
HEARTH_HUB_URL=

# Board + Hermes
# Use local when Hermes runs on the hub host; use ssh for another host.
HEARTH_HERMES_METHOD=local
# HEARTH_HERMES_SSH_HOST=hermes-host
HEARTH_HERMES_PROFILE=hearth
# Blank uses the target user's ~/.hermes/profiles/hearth. Otherwise, use an absolute path.
HEARTH_HERMES_PROFILE_DIR=
# Command that selects the Hearth profile. A dedicated alias like hearth also works.
HEARTH_HERMES_COMMAND='hermes -p hearth'
HEARTH_HERMES_TIMEOUT_S=90
# Open-Meteo for Today. Blank shows weather unknown.
HEARTH_LAT=
HEARTH_LON=
# HEARTH_BOARD_PATH=~/.local/share/hearth/board.json
