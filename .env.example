# Hub
HEARTH_PORT=8790
HEARTH_STT_URL=http://127.0.0.1:8080/v1/audio/transcriptions
# GPU selector currently fails to start on this machine; CPU works.
HEARTH_STT_MODEL=qwen3-asr-0.6b-cpu
# Device posts here. Hub binds 0.0.0.0:8790; this is the LAN URL the NOTE4 uses.
HEARTH_HUB_URL=http://192.168.2.89:8790

# Board + Hermes
# Dedicated profile on hermes-incus. Hub SSHes a oneshot after STT.
HEARTH_HERMES_SSH=hermes-incus
HEARTH_HERMES_PROFILE=hearth
HEARTH_HERMES_SESSION=family-kitchen
HEARTH_SESSION_KEY=family:kitchen
# Open-Meteo for Today. Copy this file to .env (gitignored) and set coords.
# Leave blank for "weather unknown". Sample is Whitefield, Bengaluru.
HEARTH_LAT=12.9698
HEARTH_LON=77.7499
# HEARTH_BOARD_PATH=~/.local/share/hearth/board.json
