# Local factory / as-found flash dumps. Never commit device images.
backups/*.bin
backups/*.img
backups/*.sha256
backups/board-before-demo-*.json
!backups/.gitkeep

# ESP-IDF generated. Commit sdkconfig.defaults and dependencies.lock.
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/managed_components/
firmware/sdkconfig.defaults.local

# Hub / Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
hub/.venv/

# Simulator output
sim/out/
sim/out/hearth-sim
*.pyc

# Host test binaries
tests/test_hearth_model

# Session dumps from the coding agent, never the product.
agent-tools/

# Live board if copied into the tree. Canonical path is
# ~/.local/share/hearth/board.json.
data/board.json

# Secrets and local config
.env
.env.*
!.env.example
secrets/
*.pem
board.local.json


# OS
.DS_Store
*~
