# Local factory / as-found flash dumps. Never commit device images.
backups/*.bin
backups/*.img
backups/*.sha256
!backups/.gitkeep

# ESP-IDF generated. Commit sdkconfig.defaults and dependencies.lock.
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/managed_components/
firmware/sdkconfig.defaults.local

# Hub / Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
hub/.venv/

# Simulator output
sim/out/
sim/out/hearth-sim
*.pyc

# Host test binaries
tests/test_hearth_model

# Secrets and local config
.env
.env.*
!.env.example
secrets/
*.pem

# OS
.DS_Store
*~
